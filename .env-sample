NEW_RELIC_API_KEY='NRAK-xxx'
NEW_ACCOUNT_ID="123456789"

DATE_SINCE = "2024-08-01 00:00:00"
DATE_TO = "2024-08-31 00:00:00"
REMOVE_DUPLICATES = "false"
RECORDS_PER_CSV = 100000

# If you want to write the output to AWS add your credentials here
# AWS_ACCESS_KEY_ID="X"
# AWS_SECRET_ACCESS_KEY="x"
# BUCKET="yourbucketname"

#  EXAMPLE 1: SELECT * — leave QUERY_TOTAL empty, the count query is built automatically
QUERY_TOTAL=""
QUERY="FROM MobileSession SELECT * WHERE documentNumber = '123456789'"

#  EXAMPLE 2: Explicit fields without FACET — leave QUERY_TOTAL empty, count query is built automatically
# QUERY_TOTAL=""
# QUERY="SELECT cpuRequestedCores, cpuUsedCores FROM K8sContainerSample WHERE clusterName = 'prod'"

#  EXAMPLE 3: Explicit fields with FACET — both QUERY_TOTAL and QUERY must be set
# QUERY_TOTAL="FROM MobileSession SELECT count(*) FACET device, deviceManufacturer, deviceModel, deviceType, documentNumber, osName, phoneNumber"
# QUERY="FROM MobileSession SELECT device, deviceManufacturer, deviceModel, deviceType, documentNumber, osName, phoneNumber"

